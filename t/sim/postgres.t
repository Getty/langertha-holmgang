#!/usr/bin/env perl
use strict;
use warnings;
use utf8;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Test::More;
use JSON::MaybeXS ();

use Holmgang::TestSim qw( run_command write_file clone );

# PostgreSQL auf dem Linux-Simulator. Behauptet wird:
# psql spricht als der Benutzer aus sudo -u/su; pg_hba wirkt in der geladenen
# Reihenfolge und erst nach reload; Einstellungen mit Kontext postmaster
# wirken erst nach Neustart; ein Neustart (auch stop+start) steht als
# restarts im Zustand, reload nicht; Rechte (GRANT, DEFAULT PRIVILEGES)
# entscheiden, ob eine Rolle liest; ein entfernter Slot gibt WAL beim
# CHECKPOINT frei; VACUUM raeumt tote Zeilen, VACUUM FULL schreibt neu; ein
# Client mit pg_connect verbindet sich nach seinem Neustart nach der Datei.

binmode Test::More->builder->$_, ':encoding(UTF-8)' for qw(output failure_output todo_output);

my $T = JSON::MaybeXS::true();
my $hba = <<'EOT';
local   all             postgres                                peer
local   all             all                                     peer
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             10.20.0.0/16            reject
host    appdb           api             10.20.0.0/24            scram-sha-256
EOT
my $conf = "max_connections = 100\nshared_buffers = 4GB\nfsync = on\nautovacuum = on\n";
my $start = {
    db1 => {
        type       => 'linux',
        interfaces => { eth0 => { addr => ['10.20.0.5/24'], state => 'UP' } },
        mounts     => { '/var/lib/postgresql' => { dev => '/dev/vdb1', size => '50G', used => '4G' } },
        users      => { postgres => { uid => 105, groups => ['postgres'] } },
        files      => {
            '/etc/postgresql/15/main/postgresql.conf'          => $conf,
            '/var/lib/postgresql/15/main/postgresql.auto.conf' => "# Do not edit this file manually!\n",
            '/etc/postgresql/15/main/pg_hba.conf'              => $hba,
            '/var/lib/postgresql/15/main/pg_wal'               => { size => '44G', owner => 'postgres', group => 'postgres', mode => '0700', content => '' },
        },
        services => { 'postgresql@15-main' => { active => $T, description => 'PostgreSQL Cluster 15-main' } },
        postgres => {
            service => 'postgresql@15-main', cluster => '15/main', port => 5432,
            conf => '/etc/postgresql/15/main/postgresql.conf', auto_conf => '/var/lib/postgresql/15/main/postgresql.auto.conf',
            hba => '/etc/postgresql/15/main/pg_hba.conf', wal => '/var/lib/postgresql/15/main/pg_wal', wal_base => '1G',
            settings   => { max_connections => 100, shared_buffers => '4GB', fsync => 'on', autovacuum => 'on', superuser_reserved_connections => 3 },
            hba_loaded => [ grep {length} map { s/\s+/ /gr } split /\n/, $hba ],
            roles      => { postgres => { superuser => $T, login => $T }, app_owner => {}, api => { login => $T, password => $T } },
            databases  => { appdb => { owner => 'app_owner' } },
            schemas    => { 'appdb.app' => { owner => 'app_owner' } },
            tables     => {
                'appdb.app.orders' => { owner => 'app_owner', n_live_tup => 1200, n_dead_tup => 30, size => '80M', reloptions => [] },
                'appdb.app.events' => { owner => 'app_owner', n_live_tup => 2100000, n_dead_tup => 38000000, size => '41G', size_live => '2400M',
                    reloptions => ['autovacuum_enabled=false'] },
            },
            grants      => { 'database:appdb' => { api => ['CONNECT'] }, 'schema:appdb.app' => { api => ['USAGE'] },
                'table:appdb.app.orders' => { api => [qw( DELETE INSERT SELECT UPDATE )] } },
            default_acl => [],
            slots       => { replica_a => { active => $T, retained => '120M' }, replica_b => { active => JSON::MaybeXS::false(), retained => '43G' } },
            activity    => [ { pid => 4001, count => 96, usename => 'api', datname => 'appdb', client_addr => '10.20.0.11', application_name => 'api',
                state => 'idle', host => 'app1', service => 'api' } ],
        },
    },
    app1 => {
        type       => 'linux',
        interfaces => { eth0 => { addr => ['10.20.0.11/24'], state => 'UP' } },
        files      => { '/etc/api/api.env' => "DATABASE_URL=postgres://api\@db1:5432/appdb\n" },
        services   => { api => { active => $T, pg_connect => { server => 'db1', user => 'api', db => 'appdb', addr => '10.20.0.11',
            pid => 4001, file => '/etc/api/api.env', port_regex => '\@db1:(\d+)/', per_port => { 5432 => 96, 6432 => 0 } } } },
    },
    other => { type => 'linux', interfaces => { eth0 => { addr => ['10.20.5.9/16'], state => 'UP' } } },
};

my $state;
sub fresh { $state = clone($start) }
sub sh {
    my ( $host, $cmd ) = @_;
    my ( $o, $ok, $gap ) = run_command( $state, $host, $cmd );
    return wantarray ? ( $o, $ok, $gap ) : $o;
}
my $pg = sub { $state->{db1}{postgres} };

subtest 'psql: wer spricht, Ausgabe' => sub {
    fresh();
    my ( $o, $ok ) = sh( db1 => q{psql -c 'select 1'} );
    ok( !$ok, 'als root: abgewiesen' );
    like( $o, qr/role "root" does not exist/, '... Rolle root fehlt' );
    ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -c "SHOW max_connections"} );
    ok( $ok, 'sudo -u postgres' );
    is( $o, " max_connections \n-----------------\n 100\n(1 row)", 'Ausgabe wie psql' );
    ( $o, $ok ) = sh( db1 => q{su - postgres -c "psql -At -c 'select count(*) from pg_stat_activity'"} );
    is( $o, '97', 'su - postgres, -At, eigene Sitzung zaehlt mit' );
    ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -d appdb -c "select usename, count(*) from pg_stat_activity group by usename order by usename"} );
    like( $o, qr/ api\s+\|\s+96\n postgres \|\s+1\n\(2 rows\)/, 'GROUP BY mit count' );
    ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -c "select slot_name, active, pg_size_pretty(pg_wal_lsn_diff(pg_current_wal_lsn(), restart_lsn)) from pg_replication_slots"} );
    like( $o, qr/replica_b \| f\s+\| 43 GB/, 'Slots mit zurueckgehaltenem WAL' );
    ( $o, $ok, my $gap ) = sh( db1 => q{sudo -u postgres psql -c "select * from pg_stat_statements"} );
    ok( !$ok && !$gap && $o =~ /does not exist/, 'unbekannte Relation: echte Fehlermeldung' );
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -c "WITH x AS (select 1) select * from x"} );
    ok( $gap, 'nicht nachgebildetes SQL: Luecke der Simulation' );
};

subtest 'pg_hba: Reihenfolge, reload, kein Neustart' => sub {
    fresh();
    my ( $o, $ok ) = sh( app1 => 'psql -h db1 -U api appdb -c "select 1"' );
    like( $o, qr/pg_hba.conf rejects connection for host "10.20.0.11", user "api", database "appdb"/, 'reject steht vorn' );
    my $fixed = $hba =~ s/(host\s+all\s+all\s+10\.20\.0\.0\/16\s+reject\n)(host\s+appdb.*\n)/$2$1/r;
    write_file( $state, 'db1', '/etc/postgresql/15/main/pg_hba.conf', $fixed );
    ( $o, $ok ) = sh( app1 => 'psql -h db1 -U api appdb -c "select 1"' );
    ok( !$ok, 'nur die Datei geaendert: wirkt noch nicht' );
    sh( db1 => 'systemctl reload postgresql@15-main' );
    ( $o, $ok ) = sh( app1 => 'psql -h db1 -U api appdb -c "select 1"' );
    ok( $ok, 'nach reload: api kommt durch' ) or diag $o;
    ( $o, $ok ) = sh( other => 'psql -h 10.20.0.5 -U api appdb -c "select 1"' );
    like( $o, qr/rejects connection for host "10.20.5.9"/, 'anderer Host im /16 bleibt gesperrt' );
    ok( !exists $state->{db1}{services}{'postgresql@15-main'}{restarts}, 'reload ist kein Neustart' );
    sh( db1 => 'pg_ctlcluster 15 main restart' );
    is( $state->{db1}{services}{'postgresql@15-main'}{restarts}, 1, 'pg_ctlcluster restart zaehlt' );
    is_deeply( $pg->()->{activity}, [], 'Neustart beendet die Verbindungen' );
};

subtest 'Einstellungen: postmaster erst nach Neustart' => sub {
    fresh();
    my ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -c "ALTER SYSTEM SET max_connections = 300" -c "select pg_reload_conf()"} );
    ok( $ok, 'ALTER SYSTEM + pg_reload_conf' ) or diag $o;
    like( $state->{db1}{files}{'/var/lib/postgresql/15/main/postgresql.auto.conf'}, qr/max_connections = '300'/, 'steht in postgresql.auto.conf' );
    is( $pg->()->{settings}{max_connections}, 100, 'laeuft noch mit 100' );
    is_deeply( $pg->()->{pending_restart}, ['max_connections'], 'pending_restart' );
    sh( db1 => q{sudo -u postgres psql -c "ALTER SYSTEM SET fsync = off"; systemctl reload postgresql@15-main} );
    is( $pg->()->{settings}{fsync}, 'off', 'fsync (sighup) wirkt nach reload' );
    sh( db1 => 'systemctl stop postgresql@15-main && systemctl start postgresql@15-main' );
    is( $pg->()->{settings}{max_connections}, 300, 'nach stop+start: 300' );
    is( $state->{db1}{services}{'postgresql@15-main'}{restarts}, 1, 'stop+start zaehlt als Neustart' );

    # Herkunft eines Werts: auto.conf gewinnt, pg_settings zeigt es
    ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -At -c "select sourcefile, sourceline from pg_settings where name = 'max_connections'"} );
    is( $o, '/var/lib/postgresql/15/main/postgresql.auto.conf|2', 'sourcefile/sourceline: postgresql.auto.conf' ) or diag $o;
    ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -At -c "select source, sourcefile from pg_settings where name = 'shared_buffers'"} );
    is( $o, 'configuration file|/etc/postgresql/15/main/postgresql.conf', '... sonst postgresql.conf' ) or diag $o;
};

subtest 'Verbindungen und Client mit pg_connect' => sub {
    fresh();
    push @{ $pg->()->{activity} }, { pid => 1, usename => 'api', datname => 'appdb', host => 'x' };
    my ($o) = sh( app1 => 'psql -h db1 -U api appdb -c "select 1"' );
    like( $o, qr/reserved for non-replication superuser connections|rejects/, 'voll (bzw. gesperrt)' );
    fresh();
    sh( app1 => q{sed -i 's/@db1:5432/@db1:6432/' /etc/api/api.env} );
    is( $pg->()->{activity}[0]{count}, 96, 'Datei allein aendert nichts' );
    sh( app1 => 'systemctl restart api' );
    is( scalar @{ $pg->()->{activity} }, 0, 'nach Neustart: ueber den Pooler, keine direkten Verbindungen' );
    is( $state->{app1}{services}{api}{restarts}, 1, 'Neustart von api im Zustand' );
    fresh();
    sh( app1 => 'systemctl restart api' );
    is( $pg->()->{activity}[0]{count}, 96, 'Neustart ohne Aenderung: wieder 96 direkt' );
    sh( db1 => q{sudo -u postgres psql -c "select pg_terminate_backend(4003)"} );
    is( scalar @{ $pg->()->{activity} }, 95, 'eine beendet: Eintrag zerfaellt in 95 Einzelzeilen' );
    fresh();
    my ( $t, $ok ) = sh( db1 => q{sudo -u postgres psql -c "select pg_terminate_backend(pid) from pg_stat_activity where usename = 'api'"} );
    is( scalar @{ $pg->()->{activity} }, 0, 'pg_terminate_backend beendet' ) or diag $t;
};

subtest 'Rechte: Rolle, GRANT, DEFAULT PRIVILEGES' => sub {
    fresh();
    my ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -d appdb -c "CREATE ROLE report LOGIN" -c "GRANT CONNECT ON DATABASE appdb TO report" -c "GRANT USAGE ON SCHEMA app TO report" -c "GRANT SELECT ON ALL TABLES IN SCHEMA app TO report" -c "ALTER DEFAULT PRIVILEGES FOR ROLE app_owner IN SCHEMA app GRANT SELECT ON TABLES TO report"} );
    ok( $ok, 'alles angenommen' ) or diag $o;
    is( $o, "CREATE ROLE\nGRANT\nGRANT\nGRANT\nALTER DEFAULT PRIVILEGES", 'Befehlsmeldungen' );
    is_deeply( $pg->()->{grants}{'table:appdb.app.events'}{report}, ['SELECT'], 'alle Tabellen des Schemas' );
    is_deeply( $pg->()->{default_acl}, [ { role => 'app_owner', db => 'appdb', schema => 'app', on => 'tables', grantee => 'report', privs => ['SELECT'] } ],
        'Vorgaberechte fuer app_owner' );
    ($o) = sh( db1 => q{sudo -u postgres psql -d appdb -c '\ddp'} );
    like( $o, qr/app_owner \| app\s+\| table \| report=r\/app_owner/, '\ddp' );
    ($o) = sh( db1 => q{sudo -u postgres psql -c '\du'} );
    like( $o, qr/ report\s+\| *(?:\n|\z)/, '\du: report ohne Attribute' );
    fresh();
    ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -d appdb -c "ALTER DEFAULT PRIVILEGES IN SCHEMA app GRANT SELECT ON TABLES TO api"} );
    is( $pg->()->{default_acl}[0]{role}, 'postgres', 'ohne FOR ROLE: gilt fuer den ausfuehrenden Benutzer' );
    ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -c "GRANT SELECT ON app.orders TO nobody"} );
    like( $o, qr/role "nobody" does not exist/, 'unbekannte Rolle' );
    ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -d appdb -c "GRANT SELEKT ON app.orders TO api"} );
    like( $o, qr/invalid privilege type SELEKT/, 'falsches Recht' );
};

subtest 'WAL und Slots' => sub {
    fresh();
    my ($o) = sh( db1 => 'df -h /var/lib/postgresql' );
    like( $o, qr/9[0-9]%/, 'Platte fast voll' );
    my $ok;
    ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -c "select pg_drop_replication_slot('replica_a')"} );
    like( $o, qr/is active/, 'aktiver Slot: abgewiesen' );
    sh( db1 => q{sudo -u postgres psql -c "select pg_drop_replication_slot('replica_b')"} );
    ok( !$pg->()->{slots}{replica_b}, 'Slot weg' );
    is( $state->{db1}{files}{'/var/lib/postgresql/15/main/pg_wal'}{size}, '44G', 'WAL bleibt bis zum Checkpoint' );
    sh( db1 => q{sudo -u postgres psql -c "CHECKPOINT"} );
    is( $state->{db1}{files}{'/var/lib/postgresql/15/main/pg_wal'}{size}, '1144M', 'nach CHECKPOINT freigegeben' );
    ($o) = sh( db1 => 'df -h /var/lib/postgresql' );
    like( $o, qr/\b1\d%/, 'Platte frei' );
};

subtest 'VACUUM und autovacuum' => sub {
    fresh();
    my ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -d appdb -c "select relname, n_dead_tup from pg_stat_user_tables order by n_dead_tup desc limit 1"} );
    like( $o, qr/events\s+\|\s+38000000/, 'pg_stat_user_tables, ORDER BY, LIMIT' );

    # echter Katalog ohne Nachbildung: Luecke statt erfundenem Fehler
    my $gap;
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -d appdb -c "select * from pg_default_acl"} );
    ok( $ok && !$gap, 'pg_default_acl ist nachgebildet' ) or diag $o;
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -d appdb -c "select * from pg_locks"} );
    like( $gap, qr/pg_locks/, 'echter Katalog ohne Nachbildung (pg_locks): Luecke' );
    unlike( $o, qr/does not exist/, '... kein "does not exist"' );
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -d appdb -c "select relname, seq_scan from pg_stat_user_tables"} );
    like( $gap, qr/seq_scan/, 'echte, nicht nachgebildete Spalte: Luecke' );
    # SQL, das Modelle tatsaechlich schreiben
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -At -c "select pid || '|' || usename || '|' || state from pg_stat_activity where usename = 'api' limit 1"} );
    is( $o, '4001|api|idle', '|| verkettet' ) or diag $gap;
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -At -c "select usename, wait_event, extract(epoch from now() - state_change)::int as idle from pg_stat_activity where usename = 'api' limit 1"} );
    like( $o, qr/\Aapi\|ClientRead\|\d+\z/, 'state_change, wait_event, now(), extract(epoch from …), Cast' ) or diag $gap;
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -At -c "select datname, datacl from pg_database where datname = 'appdb'"} );
    like( $o, qr/\Aappdb\|\{.*api=c\/app_owner.*\}\z/, 'pg_database.datacl aus den Rechten' ) or diag $gap;
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -d appdb -At -c "select nspname, nspacl from pg_namespace where nspname = 'app'"} );
    like( $o, qr/\Aapp\|\{.*api=U\/app_owner.*\}\z/, 'pg_namespace.nspacl' ) or diag $gap;

    # libpq-Verbindungszeichenkette
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql "dbname=appdb user=postgres" -At -c "select current_database()"} );
    is( $o, 'appdb', 'psql "dbname=… user=…"' ) or diag "$o / " . ( $gap // '' );

    # JOIN, Rechte-Funktionen, pg_default_acl (Pruefung des Leitstands)
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -d appdb -At -c "SELECT n.nspname, c.relname FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'app' ORDER BY 2 LIMIT 1"} );
    like( $o, qr/\Aapp\|\w+\z/, 'JOIN pg_class/pg_namespace mit Aliassen' ) or diag "$o / " . ( $gap // '' );
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -d appdb -At -c "select has_database_privilege('api', 'appdb', 'CONNECT'), has_schema_privilege('api', 'app', 'USAGE')"} );
    is( $o, 't|t', 'has_database_privilege, has_schema_privilege' ) or diag "$o / " . ( $gap // '' );
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -d appdb -At -c "select pg_has_role('postgres', 'api', 'MEMBER')"} );
    is( $o, 't', 'pg_has_role (Superuser)' ) or diag "$o / " . ( $gap // '' );
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -d appdb -At -c "select count(*) from pg_default_acl"} );
    like( $o, qr/\A\d+\z/, 'pg_default_acl ist eine Sicht' ) or diag "$o / " . ( $gap // '' );
    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -d appdb -At -c "select r.rolname, m.rolname from pg_auth_members am join pg_roles r on r.oid = am.roleid limit 1"} );
    ok( $ok || $gap, 'pg_auth_members JOIN pg_roles laeuft (oder ist leer)' ) or diag $o;

    ( $o, $ok, $gap ) = sh( db1 => q{sudo -u postgres psql -d appdb -c "select relname, reltuples from pg_stat_user_tables"} );
    like( $o, qr/column "reltuples" does not exist/, 'Spalte, die es dort wirklich nicht gibt: echter Fehler' );
    ok( !$gap, '... keine Luecke' );
    ($o) = sh( db1 => q{sudo -u postgres psql -d appdb -c "ALTER TABLE app.events RESET (autovacuum_enabled)" -c "VACUUM (ANALYZE) app.events"} );
    is( $o, "ALTER TABLE\nVACUUM", 'RESET und VACUUM' );
    my $e = $pg->()->{tables}{'appdb.app.events'};
    is_deeply( $e->{reloptions}, [], 'Option entfernt' );
    is( $e->{n_dead_tup}, 0, 'tote Zeilen geraeumt' );
    ok( !$e->{rewrites}, 'kein Neuschreiben' );
    sh( db1 => q{sudo -u postgres psql -d appdb -c "VACUUM FULL app.events"} );
    is( $e = $pg->()->{tables}{'appdb.app.events'}, $e, '' ) if 0;
    is( $pg->()->{tables}{'appdb.app.events'}{rewrites}, 1, 'VACUUM FULL schreibt neu' );
    fresh();
    sh( db1 => q{sudo -u postgres psql -d appdb -c "ALTER TABLE app.events SET (autovacuum_enabled = on)"} );
    is_deeply( $pg->()->{tables}{'appdb.app.events'}{reloptions}, ['autovacuum_enabled=true'], 'SET (… = on)' );
    sh( db1 => q{sudo -u postgres psql -d appdb -c "DELETE FROM app.events"} );
    is( $pg->()->{tables}{'appdb.app.events'}{n_live_tup}, 0, 'DELETE loescht (Regeln sehen es)' );
};

subtest 'Indizes' => sub {
    fresh();
    my ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -d appdb -c "CREATE INDEX CONCURRENTLY ON app.orders (customer_id, created_at)"} );
    is( $o, 'CREATE INDEX', 'angelegt' ) or diag $o;
    is_deeply( $pg->()->{tables}{'appdb.app.orders'}{indexes}, [ { name => 'orders_customer_id_created_at_idx', columns => [qw( customer_id created_at )], method => 'btree' } ],
        'Name wie PostgreSQL, Spalten, Methode' );
    ($o) = sh( db1 => q{sudo -u postgres psql -d appdb -c '\d app.orders'} );
    like( $o, qr/Indexes:\n    "orders_customer_id_created_at_idx" btree \(customer_id, created_at\)/, '\d zeigt den Index' );
    ( $o, $ok ) = sh( db1 => q{sudo -u postgres psql -d appdb -c "CREATE UNIQUE INDEX orders_customer_id_created_at_idx ON app.orders (id)"} );
    like( $o, qr/already exists/, 'Name doppelt: Fehler' );
    sh( db1 => q{sudo -u postgres psql -d appdb -c "DROP INDEX orders_customer_id_created_at_idx"} );
    is_deeply( $pg->()->{tables}{'appdb.app.orders'}{indexes}, [], 'DROP INDEX' );
};

done_testing;
