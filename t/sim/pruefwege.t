#!/usr/bin/env perl
use strict;
use warnings;
use utf8;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Test::More;
use JSON::MaybeXS ();

use Holmgang::TestSim qw( run_command write_file prepare clone diff get throws_ok need_parts );

if ( my $why = need_parts('Postgres', 'Redis') ) { plan skip_all => $why }

# Vierte Messrunde: Pruefbefehle, die eine Luecke trafen.
# Behauptet wird: pg_settings hat unit/vartype/boot_val und die Einstellungen mit
# Vorgabe (source default), Werte in der Grundeinheit; pg_file_settings zeigt jede
# Zeile der Dateien und welche wirkt; pg_sleep laeuft (auch FROM pg_sleep(x)) und
# schreibt mit log_min_duration_statement eine duration-Zeile ins Log des Clusters;
# pg_database hat datallowconn, pg_authid nur fuer Superuser. Redis: SLOWLOG
# GET/LEN/RESET und DEBUG SLEEP. Shell: flock, PIPESTATUS, md5sum/sha256sum,
# ps -fp, ps -u, lsblk.

binmode Test::More->builder->$_, ':encoding(UTF-8)' for qw(output failure_output todo_output);

my $T = JSON::MaybeXS::true();
my $pgstart = {
    db4 => {
        type  => 'linux',
        users => { postgres => { uid => 105, groups => ['postgres'] } },
        files => {
            '/etc/postgresql/15/main/postgresql.conf' =>
                "listen_addresses = '*'\nport = 5432\nmax_connections = 200\nshared_buffers = 4GB\nlog_min_duration_statement = 1000\nlog_lock_waits = off\n",
            '/var/lib/postgresql/15/main/postgresql.auto.conf' =>
                "# Do not edit this file manually!\n# It will be overwritten by the ALTER SYSTEM command.\nlog_min_duration_statement = '-1'\nwork_mem = '16MB'\n",
            '/etc/postgresql/15/main/pg_hba.conf'          => "local all postgres peer\n",
            '/var/log/postgresql/postgresql-15-main.log' => { owner => 'postgres', group => 'adm', mode => '0640',
                content => "2026-10-20 09:00:01.100 CEST [811] LOG:  database system is ready to accept connections\n" },
        },
        services => { 'postgresql@15-main' => { active => $T, user => 'postgres', exec => 'postgres' } },
        postgres => {
            service => 'postgresql@15-main', cluster => '15/main', port => 5432,
            conf => '/etc/postgresql/15/main/postgresql.conf', auto_conf => '/var/lib/postgresql/15/main/postgresql.auto.conf',
            hba => '/etc/postgresql/15/main/pg_hba.conf',
            settings => { listen_addresses => '*', port => 5432, max_connections => 200, shared_buffers => '4GB', log_min_duration_statement => '-1',
                log_lock_waits => 'off', work_mem => '16MB' },
            hba_loaded => ['local all postgres peer'],
            roles => { postgres => { superuser => $T, login => $T }, shop => { login => $T, password => $T } },
            databases => { shopdb => { owner => 'shop' } },
        },
    },
};
my $state;
sub sh { my ( $c, $h ) = @_; my @r = run_command( $state, $h // 'db4', $c ); return wantarray ? @r : $r[0] }
sub psql { my ($sql) = @_; return sh(qq{sudo -u postgres psql -At -c "$sql"}) }

subtest 'pg_settings, pg_file_settings' => sub {
    $state = clone($pgstart);
    my ( $o, $ok, $gap ) = psql("SELECT name, setting, unit, source, sourcefile, sourceline FROM pg_settings WHERE name IN ('log_min_duration_statement','work_mem') ORDER BY name");
    is( $o, "log_min_duration_statement|-1|ms|configuration file|/var/lib/postgresql/15/main/postgresql.auto.conf|3\n"
        . "work_mem|16384|kB|configuration file|/var/lib/postgresql/15/main/postgresql.auto.conf|4", 'unit und Grundeinheit, Herkunft' );
    ok( !defined $gap, '... keine Luecke' );
    is( scalar psql("SELECT name, setting, unit, context, vartype, boot_val FROM pg_settings WHERE name = 'shared_buffers'"),
        'shared_buffers|524288|8kB|postmaster|integer|16384', 'shared_buffers in 8kB-Seiten' );
    is( scalar psql("SELECT name, setting, source, sourcefile FROM pg_settings WHERE name = 'statement_timeout'"), 'statement_timeout|0|default|', 'Vorgabe: source default' );
    is( scalar psql("SELECT sourcefile, sourceline, setting, applied FROM pg_file_settings WHERE name = 'log_min_duration_statement'"),
        "/etc/postgresql/15/main/postgresql.conf|5|1000|f\n/var/lib/postgresql/15/main/postgresql.auto.conf|3|-1|t", 'pg_file_settings: beide Zeilen, die spaetere wirkt' );
    like( scalar psql("SELECT count(*) FROM pg_file_settings WHERE error IS NOT NULL"), qr/\A0\z/, 'ohne Fehler' );
};

subtest 'pg_sleep und log_min_duration_statement' => sub {
    $state = clone($pgstart);
    my ( $o, $ok, $gap ) = psql('SELECT pg_sleep(0.3)');
    ok( $ok && !defined $gap && $o eq '', 'SELECT pg_sleep(0.3)' );
    ( $o, $ok, $gap ) = psql("SELECT 'slow-ok' FROM pg_catalog.pg_sleep(0.3)");
    is( $o, 'slow-ok', 'FROM pg_catalog.pg_sleep(x)' );
    my $log = sub { scalar sh('cat /var/log/postgresql/postgresql-15-main.log') };
    unlike( $log->(), qr/duration:/, 'log_min_duration_statement = -1: nichts im Log' );
    psql('ALTER SYSTEM SET log_min_duration_statement = 250');
    psql('SELECT pg_reload_conf()');
    psql('SELECT pg_sleep(0.3)');
    like( $log->(), qr/\n2026-\d\d-\d\d \d\d:\d\d:\d\d\.\d{3} CES?T \[\d+\] postgres\@postgres LOG:  duration: 30\d\.\d{3} ms  statement: SELECT pg_sleep\(0\.3\)\z/,
        'ab 250 ms: duration-Zeile im Log des Clusters' );
    psql('SELECT pg_sleep(0.1)');
    unlike( $log->(), qr/pg_sleep\(0\.1\)/, 'kuerzer als 250 ms: keine Zeile' );
    my @d = grep { ( $_->{path}[2] // '' ) =~ /postgresql-15-main\.log/ && !grep { /\A_/ } @{ $_->{path} } } diff( $pgstart, $state );
    ok( !@d, 'Log-Zeilen sind Laufzeitspur' );
};

subtest 'pg_database, pg_authid' => sub {
    $state = clone($pgstart);
    is( scalar psql('SELECT datname, datallowconn, datdba::regrole FROM pg_database ORDER BY datname'), "postgres|t|postgres\nshopdb|t|shop", 'pg_database' );
    like( scalar psql("SELECT rolname, rolsuper, rolpassword FROM pg_authid WHERE rolname = 'shop'"), qr/\Ashop\|f\|SCRAM-SHA-256\$4096:\S+\z/, 'pg_authid (Superuser)' );
    is( scalar psql("SELECT rolpassword FROM pg_authid WHERE rolname = 'postgres'"), '', 'ohne Passwort: leer' );
};

subtest 'Redis: SLOWLOG und DEBUG SLEEP' => sub {
    # mit clock: die Zeit des Eintrags kommt aus Sim::Linux::Monitoring
    my $why = need_parts('Monitoring');
    plan skip_all => $why if $why;
    $state = {
        cache => {
            type  => 'linux',
            clock => 'Oct 24 09:12',
            files => { '/etc/redis/redis.conf' => "bind 127.0.0.1\nport 6379\nslowlog-log-slower-than 20000\nslowlog-max-len 2\n" },
            services => { 'redis-server' => { active => $T, exec => 'redis-server' } },
            redis => { service => 'redis-server', conf => '/etc/redis/redis.conf', keys => { db0 => 10 } },
        },
    };
    my $r = sub { scalar sh( "redis-cli $_[0]", 'cache' ) };
    is( $r->('SLOWLOG LEN'), '(integer) 0', 'SLOWLOG LEN leer' );
    is( $r->('SLOWLOG GET'), '(empty array)', 'SLOWLOG GET leer' );
    is( $r->('DEBUG SLEEP 0.01'), 'OK', 'DEBUG SLEEP' );
    is( $r->('SLOWLOG LEN'), '(integer) 0', '10 ms < 20 ms: kein Eintrag' );
    $r->('CONFIG SET slowlog-log-slower-than 5000');
    $r->('DEBUG SLEEP 0.01');
    is( $r->('SLOWLOG LEN'), '(integer) 1', 'ab 5 ms: ein Eintrag' );
    like( $r->('SLOWLOG GET 1'), qr/\A1\) 1\) \(integer\) 0\n   2\) \(integer\) \d{10}\n   3\) \(integer\) 100\d\d\n   4\) 1\) "DEBUG"\n      2\) "SLEEP"\n      3\) "0\.01"\n   5\) "127\.0\.0\.1:\d+"\n   6\) ""\z/,
        'SLOWLOG GET: Form wie redis-cli 7' );
    $r->('DEBUG SLEEP 0.02');
    $r->('DEBUG SLEEP 0.03');
    is( $r->('SLOWLOG LEN'), '(integer) 2', 'slowlog-max-len 2: aelteste fallen weg' );
    like( $r->('SLOWLOG GET'), qr/\A1\) 1\) \(integer\) 2\n/, 'neueste zuerst' );
    like( scalar sh( 'redis-cli --raw SLOWLOG GET 1', 'cache' ), qr/\A2\n\d{10}\n300\d\d\nDEBUG\nSLEEP\n0\.03\n127\.0\.0\.1:\d+\n\z/, '--raw' );
    is( $r->('SLOWLOG RESET'), 'OK', 'SLOWLOG RESET' );
    is( $r->('SLOWLOG LEN'), '(integer) 0', '... leer' );
    $r->('CONFIG SET slowlog-log-slower-than -1');
    $r->('DEBUG SLEEP 1');
    is( $r->('SLOWLOG LEN'), '(integer) 0', 'slower-than -1: abgeschaltet' );
};

subtest 'Shell: flock, PIPESTATUS, done < <( … ) ueber Zeilen, md5sum, ps, lsblk' => sub {
    $state = {
        app => {
            type  => 'linux',
            users => { app => { uid => 1001, groups => ['app'] } },
            files => { '/etc/app.conf' => "a=1\n", '/srv/t/alt' => { content => "x\n", mtime => 'Sep 01 10:00' }, '/srv/t/.keep' => '' },
            services => { app => { active => $T, exec => 'app', user => 'app' }, ssh => { active => $T, exec => 'sshd' } },
        },
    };
    my $s = sub { my @r = run_command( $state, 'app', $_[0] ); wantarray ? @r : $r[0] };
    my ( $o, $ok, $gap ) = $s->('( exec 9>/tmp/lk; flock -n 9; echo "rc2=$?" )');
    is( $o, 'rc2=0', 'exec 9>datei; flock -n 9' );
    ok( !defined $gap && exists $state->{app}{files}{'/tmp/lk'}, '... Sperrdatei angelegt, keine Luecke' );
    is( scalar $s->(q{flock -n /tmp/s.lock -c 'echo drin'}), 'drin', 'flock DATEI -c BEFEHL' );
    is( scalar $s->('flock -n /tmp/s2.lock echo auch'), 'auch', 'flock DATEI BEFEHL' );
    is( scalar $s->('false | true; echo "${PIPESTATUS[0]} ${PIPESTATUS[1]} ${PIPESTATUS[@]} ${#PIPESTATUS[@]}"'), '1 0 1 0 2', 'PIPESTATUS' );
    is( scalar $s->('cat /fehlt | head -n 1; echo "rc=${PIPESTATUS[0]}"'), "cat: /fehlt: No such file or directory\nrc=1", 'PIPESTATUS[0] der ersten Stufe' );
    is( scalar $s->('true; echo "$PIPESTATUS"'), '0', '$PIPESTATUS ohne Index' );
    is( scalar $s->(qq{n=0\nwhile IFS= read -r -d '' f; do\n  echo "got \$f"\n  n=\$((n + 1))\ndone < <(find "/srv/t" -maxdepth 1 -type f \\\n   ! -name '.keep' -mtime +7 -print0)\necho "n=\$n"}),
        "got /srv/t/alt\nn=1", 'done < <( find … ) ueber zwei Zeilen' );
    is( scalar $s->('md5sum /etc/app.conf'), _md5("a=1\n") . '  /etc/app.conf', 'md5sum' );
    is( scalar $s->('printf "a=1\n" | sha256sum'), _sha("a=1\n") . '  -', 'sha256sum von stdin' );
    is( scalar $s->('md5sum /fehlt'), 'md5sum: /fehlt: No such file or directory', 'md5sum: fehlt' );
    my $pid = ( $s->('systemctl show app -p MainPID --value') );
    like( scalar $s->("ps -fp $pid"), qr/\AUID +PID +PPID +C STIME TTY +TIME CMD\napp +$pid +1 /, 'ps -fp PID' );
    like( scalar $s->('ps -u app -o pid,user,comm'), qr/\A +PID USER +COMMAND\n +\d+ app +app\z/, 'ps -u BENUTZER -o …' );
    is( scalar $s->('lsblk'), "NAME     MAJ:MIN RM  SIZE RO TYPE MOUNTPOINTS\nvda      254:0    0   40G  0 disk\n\x{2514}\x{2500}vda1   254:1    0   40G  0 part /", 'lsblk aus den Einhaengepunkten' );
};

sub _md5 { require Digest::MD5; my $b = shift; return Digest::MD5::md5_hex($b) }
sub _sha { require Digest::SHA; my $b = shift; return Digest::SHA::sha256_hex($b) }

done_testing;
